NODE_ENV=development
HOST=127.0.0.1
PORT=5050
API_PREFIX=/api
API_VERSION=v1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=BDProductos
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# DB_SSL_CA_FILE=C:/certificados/ca.pem
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JSON_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
LOG_LEVEL=info
# Solo para pruebas contra PostgreSQL: TEST_DATABASE=true npm run test:db

